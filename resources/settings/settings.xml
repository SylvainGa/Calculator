<settings>
	<setting propertyKey="@Properties.AppVersion" title="@Strings.AppNameVersion">
		<settingConfig type="alphaNumeric" readonly="true"/>
	</setting>

    <setting propertyKey="@Properties.historySize" title="@Strings.setting_historySize">
		<settingConfig type="numeric" min="0" max="50" required="true"/>
    </setting>

    <setting propertyKey="@Properties.panelOrder" title="@Strings.setting_panelOrder">
		<settingConfig type="alphaNumeric" required="true"/>
    </setting>

    <setting propertyKey="@Properties.vibrateOnTouch" title="@Strings.setting_vibrateOnTouch">
		<settingConfig type="boolean" required="true"/>
    </setting>

    <setting propertyKey="@Properties.restoreOnLaunch" title="@Strings.setting_restoreOnLaunch">
		<settingConfig type="boolean" required="true"/>
    </setting>

    <setting propertyKey="@Properties.calculationMode" title="@Strings.setting_calculationMode">
        <settingConfig type="list">
            <listEntry value="0">@Strings.setting_calcBEDMAS</listEntry>
            <listEntry value="1">@Strings.setting_calcRPN</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.thousandsSep" title="@Strings.setting_thousandsSep">
        <settingConfig type="list">
            <listEntry value="0">@Strings.setting_nothing</listEntry>
            <listEntry value="1">@Strings.setting_space</listEntry>
            <listEntry value="2">@Strings.setting_comma</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.decimalSep" title="@Strings.setting_decimalSep">
        <settingConfig type="list">
            <listEntry value="0">@Strings.setting_period</listEntry>
            <listEntry value="1">@Strings.setting_comma</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.showResultInGlance" title="@Strings.setting_glance_result">
		<settingConfig type="boolean" required="true"/>
    </setting>


</settings>
